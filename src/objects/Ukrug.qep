                        "type": "float",
                        "value": "0.243176"
                    },
                    {
                        "defaultValue": "0.001",
                        "maxValue": "0.2",
                        "minValue": "0",
                        "name": "smoothFactor",
                        "type": "float",
                        "value": "0.0125699"
                    }
                ],
                "type": 2,
